rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(tripId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
    }

    // ---- Quản trị: quản trị viên gốc (theo email) + vai trò lưu trong users/{uid}.role ----
    // Quản trị viên gốc theo mã người dùng (uid) — không ghi email trong tệp luật
    function isSuper() {
      return signedIn() && request.auth.uid in ['qWcx5AAKiEf41a8sw0CdbiTtCmo2'];
    }
    function myRole() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) ? get(p).data.get('role', 'user') : 'user';
    }
    function isAdmin() { return isSuper() || (signedIn() && myRole() == 'admin'); }
    // Đội vận hành: mọi vai trò khác 'user' (biên tập viên, kiểm duyệt, marketing, vai trò tự tạo…)
    function isStaff() { return isSuper() || (signedIn() && myRole() != 'user'); }
    // Quyền của từng vai trò: settings/site.rolePerms { [vai trò]: [quyền] }; chưa cấu hình thì dùng mặc định
    function siteSettings() { return get(/databases/$(database)/documents/settings/site).data; }
    function defaultPerms(r) {
      return {
        'editor': ['content', 'feedback', 'places', 'tips'],
        'moderator': ['content', 'feedback', 'tips'],
        'marketing': ['insights', 'announce', 'notify', 'ads']
      }.get(r, []);
    }
    function hasPerm(perm) {
      return isAdmin() || (isStaff() && perm in siteSettings().get('rolePerms', {}).get(myRole(), defaultPerms(myRole())));
    }
    function validRole(r) {
      return r in ['user', 'admin', 'editor', 'moderator', 'marketing'] || r in siteSettings().get('rolePerms', {}).keys();
    }

    // Hồ sơ: tên / ảnh tự đặt, thông tin đăng nhập, thống kê dùng cho trang quản trị.
    // Người dùng không tự đổi được vai trò hay trạng thái khoá.
    function validPhoto(d) {
      return !('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() < 120000);
    }
    function validUserText(d) {
      return d.get('displayName', '') == null || (d.get('displayName', '') is string && d.get('displayName', '').size() <= 80);
    }
    match /users/{uid} {
      // Chỉ chính chủ và quản trị viên (không gồm biên tập viên) đọc được email / thông tin đăng nhập
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'googlePhoto', 'photo', 'displayName', 'role', 'banned', 'createdAt', 'lastLoginAt', 'updatedAt', 'stats', 'consentVersion', 'consentAt'])
                    && request.resource.data.get('role', 'user') == 'user'
                    && request.resource.data.get('banned', false) == false
                    && validPhoto(request.resource.data) && validUserText(request.resource.data);
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'name', 'email', 'googlePhoto', 'photo', 'displayName', 'lastLoginAt', 'updatedAt', 'stats', 'createdAt', 'annRead', 'consentVersion', 'consentAt', 'privateProfile', 'hideDates'])
                        && validPhoto(request.resource.data) && validUserText(request.resource.data))
                    || (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'banned'])
                        && validRole(request.resource.data.get('role', 'user')));
      // Tự xoá tài khoản của mình
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Cài đặt trang: ai cũng đọc; quản trị viên sửa tất cả; vai trò khác chỉ sửa phần thuộc quyền mình
    // (vai trò & quyền — rolePerms / roleDefs — chỉ quản trị viên sửa)
    function settingsKeys() {
      return resource == null ? request.resource.data.keys() : request.resource.data.diff(resource.data).affectedKeys();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin()
        || (id == 'site' && (
          (hasPerm('announce') && settingsKeys().hasOnly(['announcements', 'announcement']))
          || (hasPerm('ads') && settingsKeys().hasOnly(['ads']))
          || (hasPerm('flags') && settingsKeys().hasOnly(['flags']))
          || (hasPerm('settings') && settingsKeys().hasOnly(['homeCountry', 'features', 'community']))));
    }
    // Chỉnh sửa / thêm địa điểm nổi tiếng: ai cũng đọc; biên tập viên trở lên sửa
    match /placeOverrides/{id} {
      allow read: if true;
      allow write: if hasPerm('places');
    }
    match /customPlaces/{id} {
      allow read: if true;
      allow write: if hasPerm('places');
    }
    // Báo cáo nội dung: người đăng nhập gửi; biên tập viên trở lên xem và xử lý
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.byUid == request.auth.uid && request.resource.data.status == 'open'
                    && request.resource.data.reason is string && request.resource.data.reason.size() <= 40
                    && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 500;
      allow read, update, delete: if hasPerm('content');
      // Người báo cáo xem / xoá báo cáo của mình (khi xoá tài khoản)
      allow read, delete: if signedIn() && resource.data.byUid == request.auth.uid;
    }
    // ---- Mạng xã hội ----
    function follows(a, b) { return exists(/databases/$(database)/documents/follows/$(a + '_' + b)); }
    // Hồ sơ công khai: ai đăng nhập cũng xem; chỉ chủ hồ sơ sửa
    match /profiles/{uid} {
      allow read: if signedIn();
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
                   && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 200)
                   && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 80
                   && validPhoto(request.resource.data)
                   && (request.resource.data.get('username', '') == ''
                       || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid);
    }
    // Thống kê hồ sơ khi bật "Hồ sơ riêng tư": chỉ chính chủ và người theo dõi chéo xem được
    match /profileStats/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (follows(request.auth.uid, uid) && follows(uid, request.auth.uid)));
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // Tên người dùng (nickname, duy nhất như Instagram): mỗi tên là 1 tài liệu, ai giữ trước thì là của người đó
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && name.matches('^[a-z0-9._]{3,20}$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'at']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Bảng tin (hoạt động gần đây): chính chủ và bạn bè theo dõi chéo
    match /feeds/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (follows(request.auth.uid, uid) && follows(uid, request.auth.uid)));
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // Theo dõi: id = <người theo dõi>_<người được theo dõi>
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.to
                    && request.resource.data.to != request.auth.uid;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    // Thông báo. Người dùng thường chỉ gửi được thông báo GẮN VỚI 1 HÀNH ĐỘNG CÓ THẬT:
    //  - like: phải có lượt thích của chính mình trên check-in của người nhận
    //  - follow: phải đang theo dõi người nhận
    //  - invite / inviteAccepted / inviteDeclined: phải có lời mời tương ứng
    // Chỉ được dùng đúng các trường cho phép, độ dài giới hạn. Quản trị gửi được mọi loại.
    function noteBasics(d) {
      return d.keys().hasOnly(['to', 'type', 'from', 'fromName', 'fromPhoto', 'title', 'memoryId', 'tripId', 'postId', 'commentId', 'cc', 'read', 'createdAt'])
        && d.from == request.auth.uid && d.to is string && d.to != 'all' && d.to != request.auth.uid
        && d.read == false && d.createdAt is int
        && d.get('fromName', '') is string && d.get('fromName', '').size() <= 80
        && d.get('title', '') is string && d.get('title', '').size() <= 160
        && d.get('fromPhoto', '') is string && d.get('fromPhoto', '').size() <= 120000;
    }
    function noteBacked(d) {
      return (d.type == 'like' && d.memoryId is string
          && exists(/databases/$(database)/documents/memories/$(d.memoryId)/likes/$(request.auth.uid))
          && get(/databases/$(database)/documents/memories/$(d.memoryId)).data.uid == d.to)
        || (d.type == 'postComment' && d.postId is string && d.commentId is string
          && get(/databases/$(database)/documents/countryPosts/$(d.postId)/comments/$(d.commentId)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/countryPosts/$(d.postId)).data.uid == d.to)
        || (d.type == 'follow' && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + d.to)))
        || (d.type == 'invite' && d.tripId is string
          && get(/databases/$(database)/documents/tripInvites/$(d.tripId + '_' + d.to)).data.from == request.auth.uid
          && get(/databases/$(database)/documents/tripInvites/$(d.tripId + '_' + d.to)).data.status == 'pending')
        || (d.type in ['inviteAccepted', 'inviteDeclined'] && d.tripId is string
          && get(/databases/$(database)/documents/tripInvites/$(d.tripId + '_' + request.auth.uid)).data.from == d.to
          && get(/databases/$(database)/documents/tripInvites/$(d.tripId + '_' + request.auth.uid)).data.status
             == (d.type == 'inviteAccepted' ? 'accepted' : 'declined'));
    }
    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.to == 'all' || resource.data.to == 'role:' + myRole()
                    || resource.data.get('from', '') == request.auth.uid || isStaff());
      // Thông báo gửi cho tất cả / theo vai trò / tin tính năng & tin chung: cần quyền "Gửi thông báo"
      allow create: if signedIn() && ((noteBasics(request.resource.data) && noteBacked(request.resource.data))
                    || (isStaff() && ((request.resource.data.to != 'all' && !request.resource.data.to.matches('role:.*')
                                        && !(request.resource.data.get('type', '') in ['feature', 'system']))
                                      || hasPerm('notify'))));
      allow update: if signedIn() && resource.data.to == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.get('from', '') == request.auth.uid
                    || hasPerm('notify') || (isStaff() && !(resource.data.get('type', '') in ['feature', 'system'])));
    }

    // Lịch sử thông báo đã gửi (giữ lại cả khi thu hồi) — chỉ người có quyền "Gửi thông báo"
    match /broadcasts/{id} {
      allow read, create, update: if hasPerm('notify');
      allow delete: if isAdmin();
    }
    // Góp ý / báo lỗi: người gửi xem được của mình; biên tập viên trở lên xem tất cả và đổi trạng thái
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open'
                    && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 200;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || hasPerm('feedback'));
      allow update: if hasPerm('feedback')
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt', 'handledBy', 'history']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      match /files/{fileId} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/feedback/$(id)).data.uid == request.auth.uid || hasPerm('feedback'));
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/feedback/$(id)).data.uid == request.auth.uid;
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }
    // Nhật ký quản trị: biên tập viên / quản trị viên ghi; chỉ quản trị viên đọc; không ai sửa hay xoá được
    match /adminLogs/{id} {
      allow read: if hasPerm('logs');
      allow create: if isStaff() && request.resource.data.by == request.auth.uid
                    && request.resource.data.keys().hasOnly(['at', 'by', 'byName', 'action', 'target', 'detail'])
                    && request.resource.data.action is string && request.resource.data.action.size() <= 40
                    && request.resource.data.get('target', '') is string && request.resource.data.get('target', '').size() <= 200
                    && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 500;
      allow update, delete: if false;
    }
    // Lượt thích của chính mình ở mọi check-in (để xoá khi xoá tài khoản)
    match /{path=**}/likes/{likeUid} {
      allow read: if signedIn() && likeUid == request.auth.uid;
    }
    // Phiếu / bình luận của chính mình ở mọi bài kinh nghiệm (để xoá khi xoá tài khoản)
    match /{path=**}/votes/{vid} {
      allow read: if signedIn() && resource.data.get('uid', '') == request.auth.uid;
    }
    match /{path=**}/comments/{cid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Bộ đếm ẩn danh số tài khoản đã xoá: chỉ cộng đúng 1, và chỉ khi chính người đó đang xoá hồ sơ tài khoản
    match /stats/{id} {
      allow read: if hasPerm('insights');
      allow create, update: if id == 'deletions' && signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['count', 'byMonth'])
        && request.resource.data.count == (resource == null ? 0 : resource.data.get('count', 0)) + 1
        && request.resource.data.byMonth is map;
    }
    // Đếm số mục kế hoạch / chi phí / checklist cho trang thống kê (chỉ quản trị viên)
    match /{path=**}/plan/{itemId} {
      allow read: if hasPerm('insights');
    }
    match /{path=**}/costs/{costId} {
      allow read: if hasPerm('insights');
    }
    match /{path=**}/checklists/{listId} {
      allow read: if hasPerm('insights');
    }

    // Địa điểm đã đến / muốn đi của từng người
    match /users/{uid}/places/{placeId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Kỉ niệm: công khai thì ai cũng xem được (kể cả chưa đăng nhập);
    // riêng tư thì chỉ chủ sở hữu và thành viên chuyến đi gắn kèm
    function canReadMemory(m) {
      return m.visibility == 'public'
        || (signedIn() && m.uid == request.auth.uid)
        || (m.tripId != null && isMember(m.tripId))
        || (m.get('moderated', false) == true && hasPerm('content'));
    }
    // Giới hạn độ dài nội dung check-in (chặn ghi dữ liệu quá lớn / rác)
    function validMemory(d) {
      return d.visibility in ['public', 'private']
        && d.get('caption', '') is string && d.get('caption', '').size() <= 1000
        && d.get('occasion', '') is string && d.get('occasion', '').size() <= 100
        && d.get('authorName', '') is string && d.get('authorName', '').size() <= 80
        && (!('photos' in d) || (d.photos is list && d.photos.size() <= 10));
    }
    match /memories/{id} {
      allow read: if canReadMemory(resource.data);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && validMemory(request.resource.data);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid && validMemory(request.resource.data);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      // Lượt thích check-in công khai: mỗi người 1 document (id = uid)
      match /likes/{likeUid} {
        allow read: if signedIn() && canReadMemory(get(/databases/$(database)/documents/memories/$(id)).data);
        allow create: if signedIn() && likeUid == request.auth.uid && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/memories/$(id)).data.visibility == 'public';
        allow delete: if signedIn() && (likeUid == request.auth.uid
                      || get(/databases/$(database)/documents/memories/$(id)).data.uid == request.auth.uid);
      }
      // Kiểm duyệt: biên tập viên trở lên ẩn / hiện lại / xoá
      allow update: if hasPerm('content')
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility', 'moderated', 'moderatedBy', 'moderatedAt', 'moderationNote']);
      allow delete: if hasPerm('content');

      // Ảnh độ phân giải đầy đủ (mỗi ảnh 1 document)
      // Ảnh độ phân giải vừa (cho mạng chậm) — cùng quyền với ảnh gốc
      // Ảnh thu nhỏ (ngoài ảnh bìa) — tải khi mở xem / chọn ảnh
      match /thumbs/{photoId} {
        allow read: if canReadMemory(get(/databases/$(database)/documents/memories/$(id)).data);
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/memories/$(id)).data.uid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || hasPerm('content');
      }
      match /mid/{photoId} {
        allow read: if canReadMemory(get(/databases/$(database)/documents/memories/$(id)).data);
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/memories/$(id)).data.uid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || hasPerm('content');
      }
      match /full/{photoId} {
        allow read: if canReadMemory(get(/databases/$(database)/documents/memories/$(id)).data);
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/memories/$(id)).data.uid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || hasPerm('content');
      }
    }

    // ---- Chuyến đi chung ----
    // Chỉ thành viên (và quản trị viên) đọc được chuyến đi. Người ngoài không đọc được gì,
    // kể cả khi biết mã chuyến. Vào chuyến bằng 2 cách:
    //  1) Có đúng mã mời → tự thêm CHÍNH MÌNH (tra mã qua bảng inviteCodes, chỉ tra từng mã, không liệt kê được)
    //  2) Được chủ chuyến mời → chấp nhận lời mời (tripInvites) trong cùng 1 lần ghi
    // Chỉ chủ chuyến xoá được người khác; thành viên chỉ tự rời. Chủ chuyến không tự thêm người khác được.
    function addsOnlyMe() {
      let before = resource.data.memberIds.toSet();
      let after = request.resource.data.memberIds.toSet();
      return after.difference(before) == [request.auth.uid].toSet() && before.difference(after).size() == 0
        && request.resource.data.members.diff(resource.data.get('members', {})).affectedKeys().hasOnly([request.auth.uid]);
    }
    function removesOnly(uid) {
      let before = resource.data.memberIds.toSet();
      let after = request.resource.data.memberIds.toSet();
      return before.difference(after) == [uid].toSet() && after.difference(before).size() == 0
        && request.resource.data.get('members', {}).diff(resource.data.get('members', {})).affectedKeys().hasOnly([uid]);
    }
    function inviteAccepted(tripId) {
      let p = /databases/$(database)/documents/tripInvites/$(tripId + '_' + request.auth.uid);
      return exists(p) && get(p).data.status == 'pending' && get(p).data.to == request.auth.uid
        && getAfter(p).data.status == 'accepted';
    }
    function validTripText(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.get('emoji', '') is string && d.get('emoji', '').size() <= 16;
    }
    match /trips/{tripId} {
      allow read: if (signedIn() && request.auth.uid in resource.data.memberIds) || hasPerm('trips') || hasPerm('insights');
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid]
                    && validTripText(request.resource.data);
      allow update: if signedIn() && (
        // Chủ chuyến chuyển quyền cho 1 thành viên khác (khi xoá tài khoản)
        (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId'])) ||
        request.resource.data.ownerId == resource.data.ownerId && (
        // Chủ chuyến: sửa thông tin, đổi mã, xoá thành viên — nhưng không tự thêm người khác
        (resource.data.ownerId == request.auth.uid
          && resource.data.memberIds.toSet().hasAll(request.resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && validTripText(request.resource.data)) ||
        // Tự tham gia bằng đúng mã mời hiện tại
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'joinCode'])
          && addsOnlyMe() && request.resource.data.joinCode == resource.data.inviteCode) ||
        // Chấp nhận lời mời của chủ chuyến
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'joinCode'])
          && addsOnlyMe() && inviteAccepted(tripId)) ||
        // Thành viên tự rời chuyến
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && removesOnly(request.auth.uid)) ||
        // Thành viên sửa tên, biểu tượng, ngày đi / về, điểm đến, tiền tệ
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'emoji', 'startDate', 'endDate', 'kind', 'destinations', 'currency', 'rates', 'updatedAt'])
          && validTripText(request.resource.data))
      ));
      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

      // Kế hoạch: mọi thành viên cùng thêm / sắp xếp / đánh dấu
      match /plan/{itemId} {
        allow read, create, update, delete: if isMember(tripId);
      }
      // Chi phí dự kiến / thực tế / thanh toán: cả nhóm cùng xem và ghi
      match /costs/{costId} {
        allow read, create, update, delete: if isMember(tripId);
      }
      // Checklist: chung thì cả nhóm dùng; cá nhân chỉ người tạo
      match /checklists/{listId} {
        allow read: if isMember(tripId) && (resource.data.scope == 'shared' || resource.data.ownerUid == request.auth.uid);
        allow create: if isMember(tripId) && request.resource.data.createdBy == request.auth.uid
                      && (request.resource.data.scope == 'shared' || request.resource.data.ownerUid == request.auth.uid);
        allow update, delete: if isMember(tripId) && (resource.data.scope == 'shared' || resource.data.ownerUid == request.auth.uid);
      }

      match /stops/{stopId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && request.resource.data.byUid == request.auth.uid;
        allow delete: if isMember(tripId) && resource.data.byUid == request.auth.uid;
      }
    }

    // Bảng tra mã mời: chỉ tra đúng 1 mã (get), không liệt kê được (list)
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-Z0-9]{6,8}$')
                    && request.resource.data.keys().hasOnly(['tripId', 'ownerId', 'createdAt'])
                    && request.resource.data.ownerId == request.auth.uid
                    && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Lời mời vào chuyến đi: tripInvites/{tripId}_{uid người được mời}
    // pending → accepted / declined (người được mời) hoặc cancelled (chủ chuyến). Chủ chuyến mời lại được.
    function validInvite(d, id) {
      let trip = get(/databases/$(database)/documents/trips/$(d.tripId)).data;
      return d.keys().hasOnly(['tripId', 'tripName', 'tripEmoji', 'startDate', 'endDate', 'from', 'fromName', 'fromPhoto', 'to', 'toName', 'toPhoto', 'status', 'createdAt', 'respondedAt'])
        && id == d.tripId + '_' + d.to && d.from == request.auth.uid && d.to != request.auth.uid
        && trip.ownerId == request.auth.uid && !(d.to in trip.memberIds)
        && d.status == 'pending' && d.respondedAt == null
        && d.tripName is string && d.tripName.size() <= 80
        && d.fromName is string && d.fromName.size() <= 80 && d.toName is string && d.toName.size() <= 80
        && d.fromPhoto is string && d.fromPhoto.size() <= 120000 && d.toPhoto is string && d.toPhoto.size() <= 120000
        && exists(/databases/$(database)/documents/profiles/$(d.to));
    }
    match /tripInvites/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid || isAdmin());
      allow create: if signedIn() && validInvite(request.resource.data, id);
      allow update: if signedIn() && (
        // Chủ chuyến mời lại (ghi đè lời mời cũ đã trả lời / đã huỷ)
        (resource.data.from == request.auth.uid && resource.data.status != 'pending' && validInvite(request.resource.data, id)) ||
        // Chủ chuyến huỷ lời mời đang chờ
        (resource.data.from == request.auth.uid && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status == 'cancelled') ||
        // Người được mời chấp nhận / từ chối
        (resource.data.to == request.auth.uid && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'declined'])
      );
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
    }

    // ---- Kinh nghiệm du lịch theo quốc gia (cộng đồng) ----
    function validPost(d) {
      return d.cc is string && d.cc.matches('^[A-Z]{2}$')
        && d.topic in ['visa', 'cost', 'transport', 'food', 'stay', 'scam', 'other']
        && d.title is string && d.title.size() >= 5 && d.title.size() <= 120
        && d.body is string && d.body.size() >= 20 && d.body.size() <= 5000
        && d.get('city', '') is string && d.get('city', '').size() <= 60
        && d.get('authorName', '') is string && d.get('authorName', '').size() <= 80
        && d.get('authorPhoto', '') is string && d.get('authorPhoto', '').size() <= 120000;
    }
    function voteOf(path, after) {
      return after ? (existsAfter(path) ? getAfter(path).data.v : '') : (exists(path) ? get(path).data.v : '');
    }
    function voteDelta(postId, kind) {
      let p = /databases/$(database)/documents/countryPosts/$(postId)/votes/$(request.auth.uid);
      return (voteOf(p, true) == kind ? 1 : 0) - (voteOf(p, false) == kind ? 1 : 0);
    }
    match /countryPosts/{postId} {
      allow read: if resource.data.status == 'ok' || (signedIn() && resource.data.uid == request.auth.uid) || hasPerm('tips');
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && validPost(request.resource.data)
                    && request.resource.data.status == 'ok'
                    && request.resource.data.helpful == 0 && request.resource.data.wrong == 0 && request.resource.data.comments == 0
                    && request.resource.data.keys().hasOnly(['cc', 'city', 'topic', 'title', 'body', 'uid', 'authorName', 'authorPhoto', 'helpful', 'wrong', 'comments', 'status', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && (
        // Tác giả sửa nội dung
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'topic', 'city', 'updatedAt'])
          && validPost(request.resource.data)) ||
        // Bỏ phiếu Hữu ích / Sai lệch (không tự chấm bài mình): bộ đếm thay đổi đúng bằng phiếu
        (resource.data.uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpful', 'wrong'])
          && request.resource.data.helpful == resource.data.helpful + voteDelta(postId, 'helpful')
          && request.resource.data.wrong == resource.data.wrong + voteDelta(postId, 'wrong')) ||
        // Bình luận: +1 khi thêm, -1 khi xoá (cùng 1 lần ghi với bình luận đó)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'lastCommentId'])
          && ((request.resource.data.comments == resource.data.comments + 1
                && existsAfter(/databases/$(database)/documents/countryPosts/$(postId)/comments/$(request.resource.data.lastCommentId))
                && !exists(/databases/$(database)/documents/countryPosts/$(postId)/comments/$(request.resource.data.lastCommentId)))
            || (request.resource.data.comments == resource.data.comments - 1
                && exists(/databases/$(database)/documents/countryPosts/$(postId)/comments/$(request.resource.data.lastCommentId))
                && !existsAfter(/databases/$(database)/documents/countryPosts/$(postId)/comments/$(request.resource.data.lastCommentId))))) ||
        // Kiểm duyệt
        (hasPerm('tips') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['ok', 'hidden'])
      );
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || hasPerm('tips'));

      match /votes/{uid} {
        allow read: if signedIn() && uid == request.auth.uid;
        allow create, update: if signedIn() && uid == request.auth.uid
                              && request.resource.data.keys().hasOnly(['v', 'uid', 'at']) && request.resource.data.uid == request.auth.uid
                              && request.resource.data.v in ['helpful', 'wrong']
                              && get(/databases/$(database)/documents/countryPosts/$(postId)).data.uid != request.auth.uid;
        allow delete: if signedIn() && (uid == request.auth.uid || hasPerm('tips')
                      || get(/databases/$(database)/documents/countryPosts/$(postId)).data.uid == request.auth.uid);
      }
      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['uid', 'authorName', 'authorPhoto', 'body', 'createdAt'])
                      && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
                      && request.resource.data.get('authorPhoto', '') is string && request.resource.data.get('authorPhoto', '').size() <= 120000;
        // Tác giả bài đánh dấu "câu trả lời hay nhất"
        allow update: if signedIn() && get(/databases/$(database)/documents/countryPosts/$(postId)).data.uid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['best']);
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || hasPerm('tips')
                      || get(/databases/$(database)/documents/countryPosts/$(postId)).data.uid == request.auth.uid);
      }
    }
  }
}
