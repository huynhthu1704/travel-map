rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(tripId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
    }

    // ---- Quản trị: quản trị viên gốc (theo email) + vai trò lưu trong users/{uid}.role ----
    function isSuper() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['huynhthingocthu1704@gmail.com'];
    }
    function myRole() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) ? get(p).data.get('role', 'user') : 'user';
    }
    function isAdmin() { return isSuper() || (signedIn() && myRole() == 'admin'); }
    function isStaff() { return isSuper() || (signedIn() && myRole() in ['admin', 'editor']); }

    // Hồ sơ: tên / ảnh tự đặt, thông tin đăng nhập, thống kê dùng cho trang quản trị.
    // Người dùng không tự đổi được vai trò hay trạng thái khoá.
    function validPhoto(d) {
      return !('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() < 120000);
    }
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'googlePhoto', 'photo', 'displayName', 'role', 'banned', 'createdAt', 'lastLoginAt', 'updatedAt', 'stats'])
                    && request.resource.data.get('role', 'user') == 'user'
                    && request.resource.data.get('banned', false) == false
                    && validPhoto(request.resource.data);
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'name', 'email', 'googlePhoto', 'photo', 'displayName', 'lastLoginAt', 'updatedAt', 'stats', 'createdAt', 'annRead'])
                        && validPhoto(request.resource.data))
                    || (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'banned'])
                        && request.resource.data.get('role', 'user') in ['user', 'editor', 'admin']);
    }

    // Cài đặt trang: ai cũng đọc; chỉ quản trị viên sửa
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Chỉnh sửa / thêm địa điểm nổi tiếng: ai cũng đọc; biên tập viên trở lên sửa
    match /placeOverrides/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /customPlaces/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    // Báo cáo nội dung: người đăng nhập gửi; biên tập viên trở lên xem và xử lý
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.byUid == request.auth.uid && request.resource.data.status == 'open';
      allow read, update, delete: if isStaff();
    }
    // ---- Mạng xã hội ----
    function follows(a, b) { return exists(/databases/$(database)/documents/follows/$(a + '_' + b)); }
    // Hồ sơ công khai: ai đăng nhập cũng xem; chỉ chủ hồ sơ sửa
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
                   && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 200);
    }
    // Bảng tin (hoạt động gần đây): chính chủ và bạn bè theo dõi chéo
    match /feeds/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (follows(request.auth.uid, uid) && follows(uid, request.auth.uid)));
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // Theo dõi: id = <người theo dõi>_<người được theo dõi>
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.to
                    && request.resource.data.to != request.auth.uid;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }
    // Thông báo: người dùng gửi được "thích" / "theo dõi" cho người khác; quản trị gửi mọi loại (kể cả cho tất cả)
    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.to == 'all' || isStaff());
      allow create: if signedIn() && (
        (request.resource.data.from == request.auth.uid && request.resource.data.type in ['like', 'follow']
          && request.resource.data.to is string && request.resource.data.to != 'all' && request.resource.data.to != request.auth.uid
          && request.resource.data.read == false)
        || isStaff());
      allow update: if signedIn() && resource.data.to == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || isStaff());
    }

    // Góp ý / báo lỗi: người gửi xem được của mình; biên tập viên trở lên xem tất cả và đổi trạng thái
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open';
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt', 'handledBy', 'history']);
      allow delete: if isAdmin();
      match /files/{fileId} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/feedback/$(id)).data.uid == request.auth.uid || isStaff());
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/feedback/$(id)).data.uid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }
    // Đếm số mục kế hoạch / chi phí / checklist cho trang thống kê (chỉ quản trị viên)
    match /{path=**}/plan/{itemId} {
      allow read: if isAdmin();
    }
    match /{path=**}/costs/{costId} {
      allow read: if isAdmin();
    }
    match /{path=**}/checklists/{listId} {
      allow read: if isAdmin();
    }

    // Địa điểm đã đến / muốn đi của từng người
    match /users/{uid}/places/{placeId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Kỉ niệm: công khai thì ai cũng xem được (kể cả chưa đăng nhập);
    // riêng tư thì chỉ chủ sở hữu và thành viên chuyến đi gắn kèm
    function canReadMemory(m) {
      return m.visibility == 'public'
        || (signedIn() && m.uid == request.auth.uid)
        || (m.tripId != null && isMember(m.tripId))
        || (m.get('moderated', false) == true && isStaff());
    }
    match /memories/{id} {
      allow read: if canReadMemory(resource.data);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.visibility in ['public', 'private'];
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      // Lượt thích check-in công khai: mỗi người 1 document (id = uid)
      match /likes/{likeUid} {
        allow read: if signedIn() && canReadMemory(get(/databases/$(database)/documents/memories/$(id)).data);
        allow create: if signedIn() && likeUid == request.auth.uid && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/memories/$(id)).data.visibility == 'public';
        allow delete: if signedIn() && likeUid == request.auth.uid;
      }
      // Kiểm duyệt: biên tập viên trở lên ẩn / hiện lại / xoá
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility', 'moderated', 'moderatedBy', 'moderatedAt', 'moderationNote']);
      allow delete: if isStaff();

      // Ảnh độ phân giải đầy đủ (mỗi ảnh 1 document)
      // Ảnh độ phân giải vừa (cho mạng chậm) — cùng quyền với ảnh gốc
      // Ảnh thu nhỏ (ngoài ảnh bìa) — tải khi mở xem / chọn ảnh
      match /thumbs/{photoId} {
        allow read: if canReadMemory(get(/databases/$(database)/documents/memories/$(id)).data);
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/memories/$(id)).data.uid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isStaff();
      }
      match /mid/{photoId} {
        allow read: if canReadMemory(get(/databases/$(database)/documents/memories/$(id)).data);
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/memories/$(id)).data.uid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isStaff();
      }
      match /full/{photoId} {
        allow read: if canReadMemory(get(/databases/$(database)/documents/memories/$(id)).data);
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/memories/$(id)).data.uid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isStaff();
      }
    }

    // Chuyến đi chung
    match /trips/{tripId} {
      // Người đã đăng nhập đọc được để tham gia bằng mã mời
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid];
      // Chủ chuyến đi sửa/xoá; thành viên mới chỉ được thêm/bớt chính mình
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members']) ||
        // Thành viên được sửa tên, biểu tượng và ngày đi / ngày về
        (request.auth.uid in resource.data.memberIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'emoji', 'startDate', 'endDate', 'kind', 'destinations', 'currency', 'rates', 'updatedAt']))
      );
      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

      // Kế hoạch: mọi thành viên cùng thêm / sắp xếp / đánh dấu
      match /plan/{itemId} {
        allow read, create, update, delete: if isMember(tripId);
      }
      // Chi phí dự kiến / thực tế / thanh toán: cả nhóm cùng xem và ghi
      match /costs/{costId} {
        allow read, create, update, delete: if isMember(tripId);
      }
      // Checklist: chung thì cả nhóm dùng; cá nhân chỉ người tạo
      match /checklists/{listId} {
        allow read: if isMember(tripId) && (resource.data.scope == 'shared' || resource.data.ownerUid == request.auth.uid);
        allow create: if isMember(tripId) && request.resource.data.createdBy == request.auth.uid
                      && (request.resource.data.scope == 'shared' || request.resource.data.ownerUid == request.auth.uid);
        allow update, delete: if isMember(tripId) && (resource.data.scope == 'shared' || resource.data.ownerUid == request.auth.uid);
      }

      match /stops/{stopId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && request.resource.data.byUid == request.auth.uid;
        allow delete: if isMember(tripId) && resource.data.byUid == request.auth.uid;
      }
    }
  }
}
